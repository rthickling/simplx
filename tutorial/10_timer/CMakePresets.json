{
  "version": 3,
  "configurePresets": [
    {
      "name": "gcc16",
      "binaryDir": "${sourceDir}/build/gcc16",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc-16",
        "CMAKE_CXX_COMPILER": "g++-16",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "gcc16",
      "configurePreset": "gcc16"
    }
  ]
}